{
  "name": "lolhelper",
  "productName": "LoL Helper",
  "version": "0.15.0",
  "description": "Windows desktop assistant for League of Legends: counter-picks in champion select, item builds against your lane opponent, champion and item database.",
  "type": "module",
  "author": "Rafał Polak (Banzamel)",
  "license": "MIT",
  "homepage": "https://github.com/Banzamel/LoLHelper#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/Banzamel/LoLHelper.git"
  },
  "bugs": {
    "url": "https://github.com/Banzamel/LoLHelper/issues"
  },
  "keywords": [
    "league-of-legends",
    "lol",
    "counter-pick",
    "item-build",
    "tauri",
    "lcu",
    "champion-select"
  ],
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "tauri": "tauri",
    "start": "tauri dev",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p test",
    "fetch-data": "node --experimental-strip-types scripts/fetch-data.ts",
    "make-icon": "powershell -ExecutionPolicy Bypass -File scripts/make-icon.ps1 && tauri icon build/icon.png -o src-tauri/icons",
    "version:check": "node scripts/version.cjs check",
    "version": "node scripts/version.cjs stamp && git add CHANGELOG.md",
    "release:patch": "npm version patch -m \"Release v%s\"",
    "release:minor": "npm version minor -m \"Release v%s\"",
    "release:major": "npm version major -m \"Release v%s\"",
    "release:manifests": "node scripts/release-manifests.js",
    "dist": "node scripts/docker-build.js"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-global-shortcut": "^2.4.1",
    "@tauri-apps/plugin-http": "^2.8.3",
    "@tauri-apps/plugin-opener": "^2.7.2",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.14.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.4",
    "@types/node": "^24.12.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "typescript": "^5.9.3",
    "vite": "^8.0.4",
    "vitest": "^5.1.0"
  }
}
